# Plain KEY=value lines: no quotes, no comments after a value.
# Copy lives at /home/factorio/.config/factorio/secrets.env (owner factorio, mode 600). Edit with:
#   sudo -u factorio nano /home/factorio/.config/factorio/secrets.env
# then apply with: sudo -u factorio /home/factorio/bin/factorio-apply

# factorio.com account (factorio.com → profile): downloads mods for the server. Also made a server admin.
FACTORIO_USERNAME=
FACTORIO_TOKEN=

# The only thing keeping strangers out (no whitelist, F3): 20+ random letters and digits, no symbols.
GAME_PASSWORD=

# Cloudflare API token from the "Edit zone DNS" template, limited to zone howoldismoose.com.
CLOUDFLARE_API_TOKEN=

# Optional
SERVER_NAME=howoldismoose
# Comma-separated factorio.com names to make admins, besides FACTORIO_USERNAME
EXTRA_ADMINS=
DDNS_HOSTNAME=factorio.howoldismoose.com
