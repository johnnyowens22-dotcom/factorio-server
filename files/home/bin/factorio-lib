# Shared by the factorio-* scripts (sourced). Talks to this account's rootless Docker daemon only.
HOME=$(getent passwd "$(id -un)" | cut -d: -f6); export HOME
cd "$HOME"   # sudo -u keeps the caller's folder, which this account may not enter
SECRETS="$HOME/.config/factorio/secrets.env"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DOCKER_HOST="unix://$XDG_RUNTIME_DIR/docker.sock"
export PATH="/usr/bin:/bin:/usr/sbin:/sbin"
dc() { docker compose -f "$HOME/compose.yml" --env-file "$SECRETS" "$@"; }
log() { echo "$*"; }
# Raw "/players online" answer: "Online players (N):" then "  <name> (online)" per player. Empty if no answer.
players_online_raw() {
  timeout 30 docker exec factorio rcon /players online 2>/dev/null
}
# Number of players online (from a raw answer on stdin), or empty if there was no answer.
players_count() { sed -n 's/^Online players (\([0-9]*\)).*/\1/p' | head -1; }
# Names of the players online (from a raw answer on stdin), one per line. Factorio names are letters,
# digits, "_", "-" and "."; anything else is dropped, so a name can never break the JSON written from it.
players_names() { sed -n 's/^  *\([A-Za-z0-9_.-]\{1,60\}\) (online)$/\1/p'; }
# F16: the game container's memory as a JSON fragment ("mem":{...}), from its cgroup (the kernel's own accounting:
# memory.peak and memory.events catch even a sub-second autosave spike). Empty if the container isn't running.
container_id() { docker inspect -f '{{.Id}}' factorio 2>/dev/null; }
mem_json() {
  cid=$(container_id) || return 0
  case "$cid" in ''|*[!0-9a-f]*) return 0 ;; esac
  u=$(id -u)
  d=$(ls -d "${CGROUP_ROOT:-/sys/fs/cgroup}/user.slice/user-$u.slice/user@$u.service/"*"/docker-$cid.scope" 2>/dev/null | head -1)
  [ -n "$d" ] && [ -r "$d/memory.stat" ] || return 0
  num() { case "$1" in ''|*[!0-9]*) echo null ;; *) echo "$1" ;; esac; }   # "max" (no limit) and junk -> null
  anon=$(awk '$1=="anon"{print $2}' "$d/memory.stat"); file=$(awk '$1=="file"{print $2}' "$d/memory.stat")
  emax=$(awk '$1=="max"{print $2}' "$d/memory.events"); okill=$(awk '$1=="oom_kill"{print $2}' "$d/memory.events")
  printf '"mem":{"anon":%s,"file":%s,"swap":%s,"max":%s,"swap_max":%s,"peak":%s,"events_max":%s,"oom_kill":%s}' \
    "$(num "$anon")" "$(num "$file")" "$(num "$(cat "$d/memory.swap.current" 2>/dev/null)")" \
    "$(num "$(cat "$d/memory.max")")" "$(num "$(cat "$d/memory.swap.max" 2>/dev/null)")" \
    "$(num "$(cat "$d/memory.peak" 2>/dev/null)")" "$(num "$emax")" "$(num "$okill")"
}
# Number of players online, or empty if the server isn't answering.
players_online() {
  players_online_raw | players_count
}
