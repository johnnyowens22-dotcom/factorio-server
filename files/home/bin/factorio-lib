# Shared by the factorio-* scripts (sourced). Talks to this account's rootless Docker daemon only.
# FACTORIO_TEST_HOME / FACTORIO_TEST_BIN: only tests/test-update.sh sets them (a fake home, stub docker + curl).
HOME=${FACTORIO_TEST_HOME:-$(getent passwd "$(id -un)" | cut -d: -f6)}; export HOME
cd "$HOME"   # sudo -u keeps the caller's folder, which this account may not enter
SECRETS="$HOME/.config/factorio/secrets.env"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DOCKER_HOST="unix://$XDG_RUNTIME_DIR/docker.sock"
export PATH="${FACTORIO_TEST_BIN:+$FACTORIO_TEST_BIN:}/usr/bin:/bin:/usr/sbin:/sbin"
dc() { docker compose -f "$HOME/compose.yml" --env-file "$SECRETS" "$@"; }
log() { echo "$*"; }
# Raw "/players online" answer: "Online players (N):" then "  <name> (online)" per player. Empty if no answer.
players_online_raw() {
  timeout 30 docker exec factorio rcon /players online 2>/dev/null
}
# Number of players online (from a raw answer on stdin), or empty if there was no answer.
players_count() { sed -n 's/^Online players (\([0-9]*\)).*/\1/p' | head -1; }
# Names of the players online (from a raw answer on stdin), one per line. Factorio names are letters,
# digits, "_", "-" and "."; anything else is dropped, so a name can never break the JSON written from it.
players_names() { sed -n 's/^  *\([A-Za-z0-9_.-]\{1,60\}\) (online)$/\1/p'; }
# F16: the game container's memory as a JSON fragment ("mem":{...}), from its cgroup (the kernel's own accounting:
# memory.peak and memory.events catch even a sub-second autosave spike). Empty if the container isn't running.
container_id() { docker inspect -f '{{.Id}}' factorio 2>/dev/null; }
mem_json() {
  cid=$(container_id) || return 0
  case "$cid" in ''|*[!0-9a-f]*) return 0 ;; esac
  u=$(id -u)
  d=$(ls -d "${CGROUP_ROOT:-/sys/fs/cgroup}/user.slice/user-$u.slice/user@$u.service/"*"/docker-$cid.scope" 2>/dev/null | head -1)
  [ -n "$d" ] && [ -r "$d/memory.stat" ] || return 0
  num() { case "$1" in ''|*[!0-9]*) echo null ;; *) echo "$1" ;; esac; }   # "max" (no limit) and junk -> null
  anon=$(awk '$1=="anon"{print $2}' "$d/memory.stat"); file=$(awk '$1=="file"{print $2}' "$d/memory.stat")
  emax=$(awk '$1=="max"{print $2}' "$d/memory.events"); okill=$(awk '$1=="oom_kill"{print $2}' "$d/memory.events")
  printf '"mem":{"anon":%s,"file":%s,"swap":%s,"max":%s,"swap_max":%s,"peak":%s,"events_max":%s,"oom_kill":%s}' \
    "$(num "$anon")" "$(num "$file")" "$(num "$(cat "$d/memory.swap.current" 2>/dev/null)")" \
    "$(num "$(cat "$d/memory.max")")" "$(num "$(cat "$d/memory.swap.max" 2>/dev/null)")" \
    "$(num "$(cat "$d/memory.peak" 2>/dev/null)")" "$(num "$emax")" "$(num "$okill")"
}
# Number of players online, or empty if the server isn't answering.
players_online() {
  players_online_raw | players_count
}

# ---- F26 (docs/self-built-image.md): the game image is built here from factorio.com's stable release.
IMG=factorio-local                                   # factorio-local:<version>, :current (compose runs it), :previous
BASE_REF=debian:trixie-slim                          # Debian base of the recipe in ~/image (pinned by digest per build)
STATE_DIR="$HOME/.local/state/factorio"
HOLD="$HOME/.config/factorio/hold"                   # written by factorio-rollback: no automatic updates while it exists
UPDATE_JSON=${FACTORIO_UPDATE_OUT:-/run/factorio/update.json}
img_id() { docker image inspect -f '{{.Id}}' "$1" 2>/dev/null || true; }
img_label() { docker image inspect -f "{{index .Config.Labels \"$2\"}}" "$1" 2>/dev/null | sed 's/^<no value>$//' || true; }
valid_version() { printf '%s' "$1" | grep -Eq '^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,4}$'; }
version_gt() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$1" ]; }
# "<version> <sha256>" of factorio.com's stable headless server (= Steam's default branch), or failure.
stable_release() {
  v=$(curl -fsS --max-time 30 https://factorio.com/api/latest-releases \
      | python3 -I -c 'import json,sys; print(json.load(sys.stdin)["stable"]["headless"])' 2>/dev/null) || return 1
  valid_version "$v" || return 1
  s=$(curl -fsS --max-time 30 https://factorio.com/download/sha256sums/ \
      | awk -v f="factorio-headless_linux_$v.tar.xz" '$2 == f {print $1; exit}') || return 1
  printf '%s' "$s" | grep -Eq '^[0-9a-f]{64}$' || return 1
  echo "$v $s"
}
# The Debian base as an exact digest. Docker Hub is asked at most once a day (anonymous pulls are rate-limited);
# if it can't be reached, the copy already here is used.
base_digest() {
  if [ -z "$(img_id "$BASE_REF")" ] || [ -z "$(find "$STATE_DIR/base-checked" -mmin -1440 2>/dev/null)" ]; then
    docker pull -q "$BASE_REF" >/dev/null 2>&1 && touch "$STATE_DIR/base-checked"
  fi
  d=$(docker image inspect -f '{{index .RepoDigests 0}}' "$BASE_REF" 2>/dev/null) || return 1
  case "$d" in *@sha256:*) echo "$d" ;; *) return 1 ;; esac
}
# A short hash of the recipe in ~/image: a changed recipe (an upstream fix copied in) rebuilds by itself.
recipe_hash() { (cd "$HOME/image" && find . -type f | LC_ALL=C sort | xargs sha256sum | sha256sum | cut -c1-16); }
