#!/bin/sh
# F13: publish the online player count for the media server's torrent throttle (streambox docs/11).
# Runs as the factorio user service factorio-status.service: every 60 s, ask the server over RCON (the same
# query factorio-update relies on) and atomically replace /run/factorio/online with "players=N at=<epoch>".
# No answer (server stopped, starting or updating) -> nothing is written and the file goes stale, which the
# media side reads as "nobody playing". Every RCON call logs one line in the server log (FG17): keep 60 s.
set -u
. "$(dirname "$0")/factorio-lib"
OUT=${FACTORIO_STATUS_OUT:-/run/factorio/online}   # override only for tests
while :; do
  n=$(players_online)
  case "$n" in
    ''|*[!0-9]*) ;;
    *) printf 'players=%s at=%s\n' "$n" "$(date +%s)" > "$OUT.tmp" && mv -f "$OUT.tmp" "$OUT" ;;
  esac
  sleep 60
done
