#!/bin/sh
# F13 + F14: publish who is playing, for the media server (streambox docs/11 throttle, docs/13 dashboard).
# Runs as the factorio user service factorio-status.service: every 60 s, ask the server over RCON (the same
# query factorio-update relies on) and atomically replace
#   /run/factorio/online        "players=N at=<epoch>"                      (F13, read by the torrent throttle)
#   /run/factorio/players.json  {"at":<epoch>,"players":N,"online":[names],"mem":{...}} (F14 + F16 memory, dashboard)
# Both come from one RCON call. No answer (server stopped, starting or updating) -> nothing is written and the
# files go stale, which the media side reads as "nobody playing". Every RCON call logs one line in the server
# log (FG17): keep 60 s.
set -u
. "$(dirname "$0")/factorio-lib"
OUT=${FACTORIO_STATUS_OUT:-/run/factorio/online}   # override only for tests
JSON=$(dirname "$OUT")/players.json
while :; do
  raw=$(players_online_raw)
  n=$(printf '%s\n' "$raw" | players_count)
  case "$n" in
    ''|*[!0-9]*) ;;
    *) now=$(date +%s)
       names=$(printf '%s\n' "$raw" | players_names | sed 's/.*/"&"/' | paste -sd, -)
       mem=$(mem_json)
       printf '{"at":%s,"players":%s,"online":[%s]%s}\n' "$now" "$n" "$names" "${mem:+,$mem}" > "$JSON.tmp" && mv -f "$JSON.tmp" "$JSON"
       printf 'players=%s at=%s\n' "$n" "$now" > "$OUT.tmp" && mv -f "$OUT.tmp" "$OUT" ;;
  esac
  sleep 60
done
