#!/bin/sh
# Mirror the save backups off the NVMe to the media server's pool (F18, closes O1; exact mirror since F19). Root, daily
# at 03:50 (after the 03:30 backup), from factorio-offcopy.timer. One way only: reads /home/factorio/backups, never
# writes there; the factorio account gets no access to the pool. On the pool the copies are covered by SnapRAID parity
# (streambox D77).
#   - copies each save-*.zip not already on the pool (.part, compared, then renamed)
#   - removes pool copies that are no longer in ~/backups, so the pool holds exactly the newest 30 that factorio-backup
#     keeps (F19). One guard: if ~/backups has no saves at all, nothing is removed (a wiped folder doesn't wipe the pool)
#   - does nothing (and fails) if the pool isn't mounted: writing to /mnt/storage then would fill the NVMe under it
set -eu
SRC=/home/factorio/backups
POOL=/mnt/storage
DEST=$POOL/backups/factorio
log() { logger -t factorio-offcopy "$*"; echo "$*"; }

[ "$(findmnt -n -o FSTYPE "$POOL" 2>/dev/null)" = fuse.mergerfs ] || { log "ERROR: $POOL is not mounted (mergerfs): nothing copied"; exit 1; }
[ -d "$POOL/backups" ] || { log "ERROR: $POOL/backups missing: nothing copied"; exit 1; }
[ -d "$SRC" ] || { log "no $SRC yet: nothing to copy"; exit 0; }
# root:<group of the backups folder>, 2750: the media server's user can read (copy a save to a PC), not write
install -d -m 2750 -o root -g "$(stat -c %g "$POOL/backups")" "$DEST"

n=0
for f in "$SRC"/save-*.zip; do
  [ -f "$f" ] || continue
  b=$(basename "$f")
  [ -f "$DEST/$b" ] && continue
  cp -p "$f" "$DEST/$b.part"
  if cmp -s "$f" "$DEST/$b.part"; then
    chown root:"$(stat -c %g "$DEST")" "$DEST/$b.part"; chmod 640 "$DEST/$b.part"
    mv "$DEST/$b.part" "$DEST/$b"; n=$((n + 1))
  else
    rm -f "$DEST/$b.part"; log "ERROR: $b differs after copying: removed, will retry next run"; exit 1
  fi
done

r=0
if ls "$SRC"/save-*.zip >/dev/null 2>&1; then
  for f in "$DEST"/save-*.zip; do
    [ -f "$f" ] || continue
    [ -f "$SRC/$(basename "$f")" ] && continue
    rm -f "$f"; r=$((r + 1))
  done
else
  log "WARNING: $SRC has no saves: pool copies left as they are"
fi
rm -f "$DEST"/*.part
log "copied $n new save(s), removed $r no longer in $SRC; $(ls -1 "$DEST"/save-*.zip 2>/dev/null | wc -l) on the pool"
