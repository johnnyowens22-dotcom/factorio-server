#!/usr/bin/python3 -I
"""Factorio security report (docs/plan.md, F11, F15). Read-only.

  sudo factorio-report               the report in the terminal
  factorio-report --json FILE        the same data as JSON, written atomically and world-readable (F15: the
                                     factorio-report.timer writes /run/factorio/report.json for the media
                                     server's dashboard every 5 min; skips the "/players online" RCON call,
                                     which /run/factorio/players.json already answers)

Who has ever joined, who was refused (grouped by IP/name/reason), the isolation firewall's counters with a
verdict, whether the DNS record points home, and the newest backup.
"""
import collections, datetime, json, os, pwd, re, subprocess, sys, time, urllib.request

USER = "factorio"
HOSTNAME = "factorio.howoldismoose.com"
BOLD, RED, YEL, GRN, END = ("\033[1m", "\033[31m", "\033[33m", "\033[32m", "\033[0m") if sys.stdout.isatty() else ("",) * 5

REASONS = {
    "PasswordMissing": "no password entered",
    "PasswordMismatch": "WRONG password",
    "UserVerificationMissing": "not logged into factorio.com in the game",
    "UserVerificationFailed": "factorio.com login check failed",
    "ModsMismatch": "mods differ (sync mods with server)",
    "VersionMismatch": "different game version",
    "UserBanned": "banned",
    "UserNotWhitelisted": "not whitelisted",
    "MaxPlayerLimitReached": "server full",
}
REFUSE = re.compile(r"^(\S+)\s+.*Refusing connection for address \(IP ADDR:\(\{(.+):\d+\}\)\), username \((.*)\)\. (\w+)")
JOIN = re.compile(r"^(\S+)\s+.*\[JOIN\] (\S+) joined the game")
PLAYER = re.compile(r"^\s+(\S.{0,59}?)( \(online\))?\s*$")   # a line of "/players": "  name" or "  name (online)"


def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def fdocker(*args):
    """docker against the factorio account's rootless daemon, as that account."""
    pw = pwd.getpwnam(USER)
    rt = f"/run/user/{pw.pw_uid}"
    env = {"HOME": pw.pw_dir, "XDG_RUNTIME_DIR": rt, "DOCKER_HOST": f"unix://{rt}/docker.sock",
           "PATH": "/usr/bin:/bin"}
    return run(["/usr/sbin/runuser", "-u", USER, "--", "/usr/bin/docker", *args], env=env, cwd="/", timeout=60)


def local(ts):
    """Docker's RFC 3339 UTC timestamp -> local 'YYYY-MM-DD HH:MM'."""
    try:
        t = datetime.datetime.fromisoformat(ts[:26].rstrip("Z") + "+00:00")
        return t.astimezone().strftime("%Y-%m-%d %H:%M")
    except ValueError:
        return ts[:16]


# ---------------------------------------------------------------- collect

def server(want_online):
    r = fdocker("inspect", "-f", "{{.State.Status}} {{.State.StartedAt}} {{index .Config.Labels \"factorio.version\"}}", "factorio")
    if r.returncode:
        return None
    status, started, *ver = r.stdout.split()
    created = fdocker("inspect", "-f", "{{.Created}}", "factorio").stdout.strip()
    s = {"status": status, "started": local(started), "version": ver[0] if ver else None,
         "log_since": local(created or started)}
    if want_online:
        s["online_raw"] = fdocker("exec", "factorio", "rcon", "/players online").stdout.strip()
    return s


def players():
    raw = fdocker("exec", "factorio", "rcon", "/players").stdout.strip()
    names = []
    for line in raw.splitlines()[1:]:
        m = PLAYER.match(line)
        if m:
            names.append({"name": m.group(1), "online": bool(m.group(2))})
    return {"raw": raw, "all": names}


def log_events():
    logs = fdocker("logs", "--timestamps", "factorio")
    lines = (logs.stdout + logs.stderr).splitlines()
    joins = collections.OrderedDict()
    for m in map(JOIN.match, lines):
        if m:
            joins[m.group(2)] = local(m.group(1))
    agg = {}
    for m in map(REFUSE.match, lines):
        if m:
            ts, ip, name, why = m.groups()
            c = agg.setdefault((ip, name, why), [0, ""])
            c[0] += 1; c[1] = local(ts)
    refused = [{"count": n, "last": last, "ip": ip, "name": name[:60], "why": why, "reason": REASONS.get(why, why),
                "bad": why in ("PasswordMismatch", "UserBanned")}
               for (ip, name, why), (n, last) in sorted(agg.items(), key=lambda kv: -kv[1][0])]
    return {"joins": [{"name": n, "last": t} for n, t in joins.items()], "refused": refused}


def firewall():
    r = run(["nft", "-j", "list", "table", "inet", "factorio_guard"])
    if r.returncode:
        return {"loaded": False, "verdict": "not_loaded", "drops": []}
    counts = collections.Counter()
    for item in json.loads(r.stdout)["nftables"]:
        rule = item.get("rule")
        if not rule:
            continue
        chain = "output" if rule["chain"] == "from_factorio" else rule["chain"]   # FG18: the checks live there
        kind = "stray" if "stray" in rule.get("comment", "") else chain
        for e in rule["expr"]:
            if "counter" in e:
                counts[kind] += e["counter"]["packets"]
    inbound = counts["input"] + counts["forward"]
    verdict = "alert" if counts["output"] else "inbound" if inbound else "ok"
    return {"loaded": True, "stray": counts["stray"], "inbound": inbound, "output": counts["output"],
            "verdict": verdict, "drops": recent_drops()}


def recent_drops():
    """Last few logged drops since boot (the firewall logs at most ~6 a minute)."""
    r = run(["journalctl", "-k", "-b", "--no-pager", "-o", "short-iso", "-g", "factorio_guard (drop|ALERT)"])
    out = []
    for l in [l for l in r.stdout.splitlines() if "factorio_guard" in l][-8:]:
        f = dict(kv.split("=", 1) for kv in l.split() if "=" in kv)
        out.append({"at": l[:16].replace("T", " "), "kind": "ALERT" if "ALERT" in l else "drop",
                    "src": f.get("SRC", "?"), "dst": f.get("DST", "?"), "proto": f.get("PROTO", "?"),
                    "port": f.get("DPT", "-"),
                    "dir": "out " + f["OUT"] if f.get("OUT") else "in " + (f.get("IN") or "-"),
                    "uid": f.get("UID")})   # ALERT lines carry the sending user (FG18)
    return out


def dns():
    rec = run(["dig", "+short", HOSTNAME]).stdout.split()
    try:
        home = urllib.request.urlopen("https://api.ipify.org", timeout=8).read().decode().strip()
    except OSError:
        home = "?"
    return {"host": HOSTNAME, "records": rec, "home": home, "match": home in rec}


def backups():
    d = os.path.join(pwd.getpwnam(USER).pw_dir, "backups")
    files = sorted((f for f in os.listdir(d) if f.endswith(".zip")), reverse=True) if os.path.isdir(d) else []
    if not files:
        return {"count": 0}
    newest = os.path.join(d, files[0])
    return {"count": len(files), "newest": files[0], "size_mb": os.path.getsize(newest) // 1048576,
            "at": datetime.datetime.fromtimestamp(os.path.getmtime(newest)).strftime("%Y-%m-%d %H:%M")}


def collect(want_online):
    d = {"version": 1, "at": int(time.time()), "server": server(want_online)}
    if d["server"]:
        d["players"] = players()
        d["log"] = log_events()
    d["firewall"] = firewall()
    d["dns"] = dns()
    d["backups"] = backups()
    return d


# ---------------------------------------------------------------- terminal

def section(title):
    print(f"\n{BOLD}== {title}{END}")


def text(d):
    section("Server")
    s = d["server"]
    if not s:
        print(f"{RED}factorio container not found{END}")
    else:
        print(f"status {s['status']}, running since {s['started']}" + (f", version {s['version']}" if s["version"] else ""))
        print(s.get("online_raw") or "(RCON not answering)")
        section("Everyone who has ever joined this save (anyone you don't know here = the password leaked)")
        print(d["players"]["raw"] or "(RCON not answering)")
        section(f"Joins and refused connections since {s['log_since']} (container log; resets when an update recreates it)")
        lg = d["log"]
        print("joined:  " + (", ".join(f"{j['name']} (last {j['last']})" for j in lg["joins"]) if lg["joins"] else "nobody yet"))
        if not lg["refused"]:
            print("refused: none")
        else:
            print(f"refused: {sum(r['count'] for r in lg['refused'])} attempt(s)")
            print(f"  {'count':>5}  {'last':16}  {'ip':15}  {'name':16}  reason")
            for r in lg["refused"]:
                flag = RED if r["bad"] else ""
                print(f"  {r['count']:>5}  {r['last']:16}  {r['ip']:15}  {r['name'][:16]:16}  {flag}{r['reason']}{END if flag else ''}")

    section("Isolation firewall (counters reset at each reboot)")
    fw = d["firewall"]
    if not fw["loaded"]:
        print(f"{RED}table factorio_guard is NOT loaded: run systemctl status factorio-firewall{END}")
    else:
        print(f"stray packets dropped (late replies, harmless):        {fw['stray']}")
        print(f"new connections from outside the LAN, not Factorio:   {fw['inbound']} packet(s)")
        print(f"factorio account trying to reach the LAN/this box:    {fw['output']} packet(s)")
        if fw["drops"]:
            print("last logged drops (this boot):")
            for x in fw["drops"]:
                who = f"  uid {x['uid']}" if x["uid"] else ""
                print(f"  {x['at']}  {x['kind']:5}  {x['src']:>15} -> {x['dst']:15}  {x['proto']:6} port {x['port']:5}  {x['dir']}{who}")
        if fw["verdict"] == "alert":
            print(f"{RED}ALERT: the factorio account tried to reach your LAN or the media server (blocked). "
                  f"Treat the game server as compromised: stop it (factorio-docker stop factorio) and look into it.{END}")
        elif fw["verdict"] == "inbound":
            print(f"{YEL}Something other than Factorio got past the router (dropped here). Check the router for "
                  f"extra port forwards / UPnP mappings.{END}")
        else:
            print(f"{GRN}OK: nothing but Factorio reaches the box from outside, and the game server stays in its box.{END}")

    section("DNS")
    n = d["dns"]
    print(f"{n['host']} -> {', '.join(n['records']) or 'nothing'}; home IP {n['home']} "
          + (f"{GRN}(match){END}" if n["match"] else f"{YEL}(MISMATCH: check the factorio-ddns container){END}"))

    section("Backups")
    b = d["backups"]
    if not b["count"]:
        print(f"{YEL}none yet (daily at 03:30){END}")
    else:
        print(f"{b['count']} kept; newest {b['newest']} ({b['size_mb']} MB, {b['at']})")


if __name__ == "__main__":
    if os.geteuid() != 0:
        sys.exit("run with sudo: sudo factorio-report")
    if len(sys.argv) == 3 and sys.argv[1] == "--json":
        out = sys.argv[2]
        tmp = f"{out}.tmp"
        with open(tmp, "w") as f:
            json.dump(collect(want_online=False), f)
        os.chmod(tmp, 0o644)
        os.replace(tmp, out)
    elif len(sys.argv) == 1:
        text(collect(want_online=True))
    else:
        sys.exit("usage: sudo factorio-report  |  sudo factorio-report --json FILE")
